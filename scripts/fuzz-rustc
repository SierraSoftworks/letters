#!/usr/bin/env sh
# rustc as ./scripts/fuzz runs it. That build turns debug assertions and overflow checks off for the
# crates Letters depends on. Letters' own crates keep theirs: what they check is what the fuzzer is there
# to break.
case ${CARGO_PKG_NAME:-} in
  letters | letters-*) exec "$@" -C debug-assertions=on -C overflow-checks=on ;;
  *) exec "$@" ;;
esac
